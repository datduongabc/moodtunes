              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/functions/v1/api/v1/songs/{{songId}}/tags/focused",
              "host": ["{{baseUrl}}"],
              "path": ["functions", "v1", "api", "v1", "songs", "{{songId}}", "tags", "focused"],
              "query": []
            }
          }
        }
      ]
