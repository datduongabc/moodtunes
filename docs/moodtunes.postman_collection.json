{
  "info": {
    "name": "MoodTunes API",
    "description": "Generated from docs/openapi.yaml. Run \"API-02 Sign in\" first; it stores accessToken and userId. API-06 and API-10 assert the 800 ms target of NFR-PERF-04 for the collection runner.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// local midnight as the server expects for todayStart (AC-12.1.4)",
          "const d = new Date(); d.setHours(0, 0, 0, 0); pm.collectionVariables.set('todayStart', d.toISOString());"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://your-project-ref.supabase.co"
    },
    {
      "key": "apikey",
      "value": ""
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "songId",
      "value": "1"
    },
    {
      "key": "todayStart",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "API-01 Sign up (FR-01)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status 200', () => pm.expect(pm.response.code).to.be.oneOf([200]));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{apikey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/v1/signup",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "v1", "signup"],
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "API-02 Sign in or refresh tokens (FR-01)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.expect(pm.response.code).to.be.oneOf([200]));",
                  "if (pm.response.code === 200) { const b = pm.response.json(); pm.collectionVariables.set('accessToken', b.access_token); pm.collectionVariables.set('userId', b.user.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{apikey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/v1/token?grant_type=password",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "v1", "token"],
              "query": [
                {
                  "key": "grant_type",
                  "value": "password"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "API-03 Sign out (FR-01)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status 204', () => pm.expect(pm.response.code).to.be.oneOf([204]));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{apikey}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/v1/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "v1", "logout"],
              "query": []
            }
          }
        }
      ]
    },
    {
      "name": "Catalogue",
      "item": [
        {
          "name": "API-04 Search and browse the catalogue (FR-02, FR-18)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status 200', () => pm.expect(pm.response.code).to.be.oneOf([200]));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "apikey",
                "value": "{{apikey}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Prefer",
                "value": "count=exact"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/rest/v1/songs?or=(title.ilike.*night*,artist_name.ilike.*night*)&order=title.asc,id.asc&limit=20&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["rest", "v1", "songs"],
              "query": [
                {
                  "key": "or",
                  "value": "(title.ilike.*night*,artist_name.ilike.*night*)"
                },
                {
                  "key": "order",
                  "value": "title.asc,id.asc"
                },
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            }
          }
        }
      ]
    },
