# Supabase project used by the app. Both values are public by design and protected by
# row-level security (NFR-SEC-03); the service-role key must never appear here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=
# Optional: Sentry DSN for crash reports in release builds
EXPO_PUBLIC_SENTRY_DSN=
